{
  "id": "settings-pages",
  "name": "Settings pages",
  "description": "Settings' General, Appearance, About and Keybindings pages. Built into Glitched; make a copy in Settings › Plugins to change them.",
  "version": "1.0.0",
  "main": "main.ts",
  "contract": "glitched",
  "contractVersion": 2,
  "capabilities": [
    "ui.place",
    "ui.replace",
    "settings:write"
  ],
  "glitched": {
    "places": [
      {
        "id": "general",
        "at": "settings.page.general",
        "replaces": true
      },
      {
        "id": "appearance",
        "at": "settings.page.appearance",
        "replaces": true
      },
      {
        "id": "about",
        "at": "settings.page.about",
        "replaces": true
      },
      {
        "id": "keybindings",
        "at": "settings.page.keybindings",
        "replaces": true
      }
    ]
  }
}
