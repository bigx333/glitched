{
  "id": "settings-pages",
  "name": "Settings pages",
  "description": "Settings' About and Keybindings pages. Built into Glitched; make a copy in Settings › Plugins to change them.",
  "version": "1.0.0",
  "main": "main.js",
  "contract": "glitched",
  "contractVersion": 2,
  "capabilities": [
    "ui.place",
    "ui.replace"
  ],
  "glitched": {
    "places": [
      {
        "id": "about",
        "at": "settings.page.about",
        "replaces": true
      },
      {
        "id": "keybindings",
        "at": "settings.page.keybindings",
        "replaces": true
      }
    ]
  }
}
