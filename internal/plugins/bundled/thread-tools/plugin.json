{
  "id": "thread-tools",
  "name": "Thread tools",
  "description": "Copy branch name and Open in editor in a thread's menu. Built into Glitched; make a copy in Settings › Plugins to change them.",
  "version": "1.0.0",
  "main": "main.js",
  "contract": "glitched",
  "contractVersion": 2,
  "capabilities": ["ui.place", "threads:read", "clipboard", "programs"],
  "contributes": {
    "commands": [
      { "id": "copy-branch", "title": "Copy branch name" },
      { "id": "open-editor", "title": "Open in editor" }
    ]
  },
  "glitched": {
    "programs": ["git"],
    "menus": [
      { "command": "copy-branch", "at": "thread.menu" },
      { "command": "open-editor", "at": "thread.menu" }
    ]
  }
}
