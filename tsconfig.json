{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "lib": ["ES2023"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "examples/plugins/glitched.d.ts",
    "examples/plugins/**/*.ts",
    "internal/plugins/bundled/**/*.ts"
  ]
}
